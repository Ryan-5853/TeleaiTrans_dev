# syntax=docker/dockerfile:1.4
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Dependency layer only.  It is invalidated exclusively by pyproject.toml,
# so backend source edits never trigger a pip install / re-download.
COPY backend/pyproject.toml /tmp/pyproject.toml
RUN --mount=type=cache,target=/root/.cache/pip \
    python -c "import tomllib; f=open('/tmp/pyproject.toml','rb'); d=tomllib.load(f)['project']['dependencies']; print('\n'.join(d))" \
      > /tmp/requirements.txt \
    && pip install -r /tmp/requirements.txt \
    && rm -f /tmp/pyproject.toml /tmp/requirements.txt

COPY backend/app /app/backend/app
COPY simulator /app/simulator
COPY config /app/config

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--app-dir", "/app/backend", "--host", "0.0.0.0", "--port", "8000"]
